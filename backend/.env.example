# ---- Grovio backend environment (copy to .env and fill in) ----
# Never commit real secrets. Only .env.example belongs in version control.

# Runtime
NODE_ENV=development
PORT=3001

# Database (required). Use your MongoDB connection string.
MONGODB_URI=mongodb://localhost:27017/grovio
# Optional: isolated database used by the automated test suite.
MONGODB_TEST_URI=

# Optional: dedicated presentation-demo database used only by the seed script
# (backend/scripts/seed-demo.mjs). Point this at a fresh `grovio_demo` database
# and NEVER at production or any other live environment. The seed script refuses
# to write if this is missing or does not look like a demo database.
MONGODB_DEMO_URI=

# Secrets (required). JWT_SECRET signs short-lived access tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Required in production: at least 32 characters.

# Tokens
# Access token lifetime (held in memory by the SPA). Keep it short.
ACCESS_TOKEN_EXPIRES_IN=15m
# Rotating refresh token lifetime (days) for the default and "remember me".
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_DAYS_REMEMBERED=30

# Frontend origin(s) allowed by CORS (comma-separated). No wildcard with cookies.
CLIENT_ORIGIN=http://localhost:5173

# Cookies
# Secure in production. Cross-site deployments need SameSite=None + Secure.
COOKIE_SECURE=            # leave empty => auto (true only in production)
COOKIE_SAMESITE=          # leave empty => auto (lax in dev, none in production)
COOKIE_DOMAIN=            # optional shared parent domain, e.g. .example.com

# Password recovery
RESET_TOKEN_TTL_MINUTES=30
# Dev-only: return the reset token in the API response so the flow can be
# tested without an email provider. ALWAYS ignored in production.
EXPOSE_DEV_RESET_TOKEN=true

# Email delivery (optional). When unset, reset links are NOT emailed and the
# dev token mechanism above is used instead. No delivery is ever claimed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Grovio <no-reply@grovio.app>
