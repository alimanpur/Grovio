# Frontend environment variables (copy to .env and fill in).
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Never put backend secrets here — they live in the backend .env only.

# Production backend API URL (the Render-hosted Express service).
# IMPORTANT: Include the /api path — the backend mounts all routes under /api.
# Set this in the Vercel dashboard for each environment (Production + Preview).
# Development default (handled by vite.config.js proxy) is /api.
VITE_API_URL=https://your-backend.onrender.com/api
